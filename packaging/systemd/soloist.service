# Spotify Soloist as a user service: the Spotify Connect speaker that htpc-nowplaying shows.
# Install: packaging/install-soloist.sh, then
#   cp packaging/systemd/soloist.service ~/.config/systemd/user/
#   systemctl --user enable --now soloist.service
#
# `htpc-nowplaying soloist` starts Soloist (it replaces itself with it, so an exit code of 10
# still reaches systemd). The speaker name (`daemon.device_name`, default soloist-<hostname>)
# and the WebSocket address (`daemon.address`, loopback only: the WebSocket has no
# authentication) come from ~/.config/htpc-nowplaying/config.toml, and the API key from
# ~/.config/soloist/api-key (mode 600). Soloist only accepts the key on the command line, so
# other local users can see it in the process list; on a shared machine, keep that in mind.
# The binary must be at ~/.local/bin/htpc-nowplaying.

[Unit]
Description=Spotify Soloist (Spotify Connect speaker)
Documentation=https://developer.spotify.com/documentation/soloist
After=pipewire.service wireplumber.service
Wants=pipewire.service

[Service]
# Pairing (see the README, "Pairing"): the firewall port Soloist listens on is opened for the
# local network while Soloist runs with `pairing = "on"`, and closed when it stops. All three
# lines start with "-" so a missing pairing helper never keeps Soloist from running.
ExecStartPre=-/usr/bin/sudo -n /usr/local/libexec/htpc-nowplaying/pairing-port close
ExecStart=%h/.local/bin/htpc-nowplaying soloist
ExecStartPost=-%h/.local/bin/htpc-nowplaying pairing-sync
ExecStopPost=-/usr/bin/sudo -n /usr/local/libexec/htpc-nowplaying/pairing-port close
Restart=on-failure
RestartSec=5
# Exit code 10 means this Soloist build has expired (builds last 90 days). Restarting cannot
# help: run install-soloist.sh again to update, then restart the service.
RestartPreventExitStatus=10

[Install]
WantedBy=default.target
