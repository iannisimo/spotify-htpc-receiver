#!/bin/sh
# htpc-nowplaying pairing helper. Opens the TCP port Soloist listens on for pairing
# (zeroconf; random on every Soloist start) to the local network, and closes it again.
#
# Installed root-owned at /usr/local/libexec/htpc-nowplaying/pairing-port by
# install-pairing-helper.sh, which lets one user run it through `sudo -n` without a password.
#
# Usage: pairing-port open|close|status   (exactly one argument)
#
#   open    find the wildcard TCP listener of a `soloist` process owned by the calling user
#           (SUDO_UID), waiting up to 10 s for it; remove this helper's earlier rules; allow that
#           port from the local subnet(s) of the interface carrying the default route.
#   close   remove every rule this helper created, and nothing else.
#   status  report without changing anything.
#
# Each prints one line: backend=<ufw|firewalld|none|unsupported> state=<open|closed> port=<n|->
# Exit codes: 0 ok; 2 usage or refused; 3 no Soloist listener of the calling user;
#             4 unsupported firewall (open still reports the port, to open by hand);
#             5 a firewall command failed, or no local network was found.
#
# Rules it owns: ufw rules with the comment below; firewalld runtime rich rules (never
# permanent) it recorded in $RUN_DIR/firewalld-rules.

# Default word splitting (space, tab, newline), whatever the caller's environment held.
IFS=$(printf ' \t\nx')
IFS=${IFS%x}
umask 077
COMMENT=htpc-nowplaying-pairing

if [ "$(id -u)" = 0 ]; then
    PATH=/usr/sbin:/usr/bin:/sbin:/bin
    RUN_DIR=/run/htpc-nowplaying
    WAIT=10
else
    # Not root: only the tests run it like this (real ufw and firewall-cmd need root).
    RUN_DIR=${TMPDIR:-/tmp}/htpc-nowplaying
    WAIT=${PAIRING_PORT_WAIT:-10}
fi
export PATH
FWD_FILE=$RUN_DIR/firewalld-rules

usage() {
    echo "usage: pairing-port open|close|status" >&2
    exit 2
}

[ $# -eq 1 ] || usage
case $1 in
    open | close | status) CMD=$1 ;;
    *) usage ;;
esac

case ${SUDO_UID:-} in
    '')
        if [ "$(id -u)" != 0 ]; then
            echo "pairing-port: run it through sudo" >&2
            exit 2
        fi
        if [ "$CMD" = open ]; then
            echo "pairing-port: open needs SUDO_UID (run it through sudo as the Soloist user)" >&2
            exit 2
        fi
        ;;
    *[!0-9]*)
        echo "pairing-port: SUDO_UID is not a number" >&2
        exit 2
        ;;
esac
case $WAIT in '' | *[!0-9]*) WAIT=10 ;; esac

say() {
    echo "backend=$1 state=$2 port=$3"
}

if ! mkdir -p "$RUN_DIR"; then
    echo "pairing-port: cannot create $RUN_DIR" >&2
    exit 5
fi
# One run at a time: the unit and the app may call open/close together.
if command -v flock >/dev/null 2>&1; then
    exec 9>"$RUN_DIR/lock"
    if ! flock -w 30 9; then
        echo "pairing-port: another run holds the lock" >&2
        exit 5
    fi
fi

backend() {
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'; then
        echo ufw
    elif command -v firewall-cmd >/dev/null 2>&1 &&
        [ "$(firewall-cmd --state 2>/dev/null)" = running ]; then
        echo firewalld
    elif command -v nft >/dev/null 2>&1 && nft list ruleset 2>/dev/null | grep -q 'policy drop'; then
        echo unsupported
    else
        echo none
    fi
}

# Ports of wildcard TCP listeners whose process is `soloist`, with the pid: "port pid" lines.
soloist_listeners() {
    ss -ltnpH 2>/dev/null | awk '
        {
            local = $4
            n = split(local, part, ":")
            port = part[n]
            host = substr(local, 1, length(local) - length(port) - 1)
            if (host != "0.0.0.0" && host != "*") next
            if (port !~ /^[0-9]+$/ || port < 1 || port > 65535) next
            rest = $0
            while (match(rest, /\("[^"]*",pid=[0-9]+/)) {
                entry = substr(rest, RSTART + 1, RLENGTH - 1)
                rest = substr(rest, RSTART + RLENGTH)
                split(entry, f, "\",pid=")
                if (f[1] == "\"soloist") print port, f[2]
            }
        }'
}

# The calling user's Soloist pairing port, or nothing.
soloist_port() {
    soloist_listeners | while read -r port pid; do
        owner=$(ps -o uid= -p "$pid" 2>/dev/null | tr -d ' ')
        if [ -n "$owner" ] && [ "$owner" = "$SUDO_UID" ]; then
            echo "$port"
            break
        fi
    done
}

wait_for_port() {
    i=0
    while :; do
        port=$(soloist_port)
        if [ -n "$port" ] || [ "$i" -ge "$WAIT" ]; then
            echo "$port"
            return
        fi
        i=$((i + 1))
        sleep 1
    done
}

# IPv4 subnets on the link of the default-route interface; nothing wider than a /8.
local_subnets() {
    dev=$(ip -4 -o route show default 2>/dev/null |
        awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
    case $dev in '' | *[!A-Za-z0-9_.:@-]*) return ;; esac
    ip -4 -o route show dev "$dev" scope link proto kernel 2>/dev/null | awk '{ print $1 }' |
        grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}/([89]|[12][0-9]|3[0-2])$' | sort -u
}

# --- ufw -----------------------------------------------------------------------------------

ufw_own_numbers() {
    ufw status numbered 2>/dev/null |
        sed -n "s/^\[ *\([0-9][0-9]*\)\].*# $COMMENT[[:space:]]*\$/\1/p"
}

ufw_port() {
    ufw status numbered 2>/dev/null |
        sed -n "s/^\[ *[0-9][0-9]*\] *\([0-9][0-9]*\)\/tcp .*# $COMMENT[[:space:]]*\$/\1/p" |
        head -n 1
}

# Deletes the highest-numbered own rule until none is left; re-reading after each delete
# keeps the numbers right as ufw renumbers.
ufw_close() {
    count=0
    while :; do
        num=$(ufw_own_numbers | sort -n | tail -n 1)
        [ -n "$num" ] || return 0
        if ! ufw --force delete "$num" >/dev/null; then
            echo "pairing-port: ufw could not delete rule $num" >&2
            return 1
        fi
        count=$((count + 1))
        [ "$count" -lt 100 ] || return 1
    done
}

ufw_open_one() {
    ufw allow from "$1" to any port "$2" proto tcp comment "$COMMENT" >/dev/null
}

# --- firewalld -----------------------------------------------------------------------------

fwd_rule() {
    printf 'rule family="ipv4" source address="%s" port port="%s" protocol="tcp" accept' "$1" "$2"
}

fwd_port() {
    [ -f "$FWD_FILE" ] || return 0
    sed -n 's/.* port port="\([0-9][0-9]*\)".*/\1/p' "$FWD_FILE" | head -n 1
}

# Removes every recorded rule. Runtime rules vanish on a firewalld reload anyway, so the
# record is dropped even when a removal fails; the failure is still reported.
fwd_close() {
    [ -f "$FWD_FILE" ] || return 0
    ok=0
    while IFS= read -r rule; do
        [ -n "$rule" ] || continue
        if ! firewall-cmd "--remove-rich-rule=$rule" >/dev/null 2>&1; then
            echo "pairing-port: firewalld could not remove: $rule" >&2
            ok=1
        fi
    done <"$FWD_FILE"
    rm -f "$FWD_FILE"
    return $ok
}

fwd_open_one() {
    rule=$(fwd_rule "$1" "$2")
    firewall-cmd "--add-rich-rule=$rule" >/dev/null || return 1
    printf '%s\n' "$rule" >>"$FWD_FILE"
}

# --- commands ------------------------------------------------------------------------------

close_all() {
    case $1 in
        ufw) ufw_close ;;
        firewalld) fwd_close ;;
        # firewalld is not running, so its runtime rules are gone: forget them.
        *) rm -f "$FWD_FILE" ;;
    esac
}

BACKEND=$(backend)

case $CMD in
    status)
        case $BACKEND in
            ufw) port=$(ufw_port) ;;
            firewalld) port=$(fwd_port) ;;
            *) port= ;;
        esac
        if [ -n "$port" ]; then say "$BACKEND" open "$port"; else say "$BACKEND" closed -; fi
        [ "$BACKEND" = unsupported ] && exit 4
        exit 0
        ;;
    close)
        if ! close_all "$BACKEND"; then
            say "$BACKEND" closed -
            exit 5
        fi
        say "$BACKEND" closed -
        exit 0
        ;;
    open)
        if [ "$BACKEND" = none ]; then
            say none closed -
            exit 0
        fi
        port=$(wait_for_port)
        if [ -z "$port" ]; then
            echo "pairing-port: no Soloist of user $SUDO_UID is listening" >&2
            say "$BACKEND" closed -
            exit 3
        fi
        if [ "$BACKEND" = unsupported ]; then
            say unsupported closed "$port"
            exit 4
        fi
        subnets=$(local_subnets)
        if [ -z "$subnets" ]; then
            echo "pairing-port: no local network found on the default-route interface" >&2
            exit 5
        fi
        close_all "$BACKEND" || exit 5
        for subnet in $subnets; do
            case $BACKEND in
                ufw) ufw_open_one "$subnet" "$port" ;;
                firewalld) fwd_open_one "$subnet" "$port" ;;
            esac
            if [ $? -ne 0 ]; then
                echo "pairing-port: $BACKEND could not allow port $port from $subnet" >&2
                close_all "$BACKEND"
                say "$BACKEND" closed -
                exit 5
            fi
        done
        say "$BACKEND" open "$port"
        ;;
esac
